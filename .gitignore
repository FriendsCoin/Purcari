# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage
*.lcov

# Production
/build
/dist

# Misc
.DS_Store

# Environment. Ignore every .env* by default and allow back only the two files
# that are meant to be public — the previous list ignored .env.development.local
# but not .env.development, which is tracked, so a key pasted into it would have
# been committed. Note that anything VITE_-prefixed is inlined into the client
# bundle and is therefore public regardless of which file it lives in: API keys
# must never be VITE_ variables.
.env*
!.env.example
!.env.development

# Credentials
*.pem
*.key
secrets.json
credentials.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
*.tmp
*.temp
.cache

# Single-file preview builds
dist-single/
.single-build/
